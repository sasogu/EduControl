[Application]
name=com.educontrol.Client
runtime=org.freedesktop.Platform/x86_64/21.08
sdk=org.freedesktop.Sdk/x86_64/21.08
command=educontrol-cliente

[Context]
shared=network;
sockets=x11;wayland;session-bus;fallback-x11;

[Session Bus Policy]
org.gnome.ScreenSaver=talk
org.mate.ScreenSaver=talk
org.cinnamon.ScreenSaver=talk
org.freedesktop.ScreenSaver=talk

[System Bus Policy]
org.freedesktop.login1=talk
