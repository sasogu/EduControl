  "sdk-commit" : "6d6d5cb020cefade8c46a53b005d917658945160c0bb6dcc6bad9b4cca36fa4a",
  "command" : "educontrol-cliente",
  "modules" : [
    {
      "name" : "educontrol-cliente",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : ".",
          "type" : "dir"
        }
      ],
      "build-commands" : [
        "install -Dm755 cliente.py /app/bin/educontrol-cliente",
