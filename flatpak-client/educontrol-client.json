{
    "app-id": "com.educontrol.Client",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "21.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "educontrol-cliente",
    "finish-args": [
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=session-bus",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.gnome.ScreenSaver",
        "--talk-name=org.mate.ScreenSaver",
        "--talk-name=org.cinnamon.ScreenSaver",
        "--system-talk-name=org.freedesktop.login1"
    ],
    "modules": [
        {
            "name": "educontrol-cliente",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ],
            "build-commands": [
                "install -Dm755 cliente.py /app/bin/educontrol-cliente",
                "gcc -O2 -o /app/bin/educontrol-overlay overlay.c $(pkg-config --cflags --libs gtk+-3.0)"
            ]
        }
    ]
}