[Unit]
Description=EduControl Client (user session)
After=graphical-session.target

[Service]
Type=simple
# Aseguramos variables gráficas para sesiones que no exporten DISPLAY/XAUTHORITY
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/educontrol-start
Restart=on-failure

[Install]
WantedBy=default.target
