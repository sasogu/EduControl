#!/bin/sh
set -e

# Asegura propietario y permisos correctos para el wrapper
if [ -e /usr/bin/educontrol-start ]; then
  chown root:root /usr/bin/educontrol-start || true
  chmod 755 /usr/bin/educontrol-start || true
fi

# Recargar systemd user si está disponible (no falla si no existe)
if command -v systemctl >/dev/null 2>&1; then
  # No ejecutar como root para el usuario; solo recargar unidades del sistema
  systemctl daemon-reload || true
fi

exit 0
