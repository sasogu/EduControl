#!/bin/sh
set -e
# Ensure binaries are executable
if [ -x /usr/bin/educontrol-client ] || [ -f /usr/bin/educontrol-client ]; then
  chmod 755 /usr/bin/educontrol-client || true
fi
if [ -f /usr/bin/educontrol-overlay ]; then
  chmod 755 /usr/bin/educontrol-overlay || true
fi
# Copiar el archivo .desktop al directorio de aplicaciones
install -m 644 /usr/share/educontrol/educontrol-client.desktop /usr/share/applications/ || true

# Actualizar la base de datos de escritorio
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

# Configurar permisos para los archivos copiados
chmod 755 /usr/share/educontrol/cliente.py || true
chmod 755 /usr/share/educontrol/overlay.c || true
chmod 755 /usr/share/educontrol/servidor.py || true

# Compilar overlay.c si es necesario
if command -v gcc >/dev/null 2>&1; then
  gcc -o /usr/bin/educontrol-overlay /usr/share/educontrol/overlay.c || true
fi
exit 0
